{
  "name": "topstore-admin",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "cf-build": "opennextjs-cloudflare build",
    "cf-pages": "opennextjs-cloudflare build && node -e \"const fs=require('fs'),path=require('path'),src=process.cwd()+'/.open-next',dst=process.cwd()+'/.open-next-pages';fs.rmSync(dst,{recursive:true,force:true});fs.mkdirSync(dst+'/_worker.js',{recursive:true});fs.cpSync(src+'/worker.js',dst+'/_worker.js/index.js');if(fs.existsSync(src+'/assets'))fs.cpSync(src+'/assets',dst+'/assets',{recursive:true});console.log('✓ Pages output at .open-next-pages')\"",
    "start": "next start",
    "lint": "eslint"
  },
  "dependencies": {
    "@hookform/resolvers": "^5.4.0",
    "@supabase/supabase-js": "^2.106.1",
    "@tanstack/react-table": "^8.21.3",
    "bcryptjs": "^3.0.3",
    "clsx": "^2.1.1",
    "gsap": "^3.15.0",
    "jose": "^6.2.3",
    "lucide-react": "^1.16.0",
    "next": "16.2.6",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "react-hook-form": "^7.76.0",
    "react-hot-toast": "^2.6.0",
    "recharts": "^3.8.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@opennextjs/cloudflare": "^1.19.11",
    "@tailwindcss/postcss": "^4",
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.2.6",
    "tailwindcss": "^4",
    "typescript": "^5"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "sharp",
      "unrs-resolver",
      "workerd"
    ]
  }
}
